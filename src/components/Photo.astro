---
import { Picture } from 'astro:assets';
import { photo } from '../data/photos';

interface Props {
  slug: string;
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  quality?: number;
}
const { slug, alt, sizes = '(min-width: 1024px) 50vw, 100vw', class: cls, eager = false, quality = 50 } = Astro.props;
---
<Picture
  src={photo(slug)}
  alt={alt}
  formats={['avif', 'webp']}
  widths={[400, 800, 1200, 1600]}
  sizes={sizes}
  quality={quality}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class={cls}
/>
